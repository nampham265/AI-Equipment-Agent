APP_ENV=development
APP_SECRET_KEY=generate-a-random-string-here
FRONTEND_ORIGIN=http://localhost:5173

# Data backend: "excel" (default MVP), "sqlite", or "microsoft_graph"
DATA_BACKEND=excel
EXCEL_DATA_PATH=backend/data/equipment_agent.xlsx
DATABASE_URL=sqlite:///./data/app.db

# Gemini AI (Tùy chọn: nếu để trống API key, hệ thống tự động fallback sang Rule Router nội bộ)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AGENT_ROUTING_MODE=llm_primary
ALLOW_INVENTORY_DATA_TO_GEMINI=false

# Microsoft Entra ID (work/school account required - chỉ dùng khi DATA_BACKEND=microsoft_graph)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/callback

# SharePoint Site and Lists
MICROSOFT_SITE_ID=
MICROSOFT_EQUIPMENT_LIST_ID=
MICROSOFT_REQUESTS_LIST_ID=

# Permissions scope
MICROSOFT_SCOPES=openid profile offline_access User.Read Sites.ReadWrite.All

# Manager authorization (danh sách email quản lý phân tách bằng dấu phẩy)
MANAGER_EMAILS=manager.lab@bosch.com,manager@company.com

# Email via Microsoft Graph (requires Mail.Send permission)
EMAIL_NOTIFICATIONS_ENABLED=false
